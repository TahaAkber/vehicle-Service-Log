{
  "expo": {
    "name": "Vehicle Service Logs",
    "slug": "vehicle-service-logs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "vehicleservicelog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.anonymous.vehicleServiceLog"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#172333",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.vehicleServiceLog"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#172333",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow app access to scan odometer and fuel pump displays.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow app access to select odometer and fuel pump images."
        }
      ],
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "018ec13e-f586-4498-b5cc-de6c18c0ce4d"
      }
    },
    "owner": "tahaakber"
  }
}
